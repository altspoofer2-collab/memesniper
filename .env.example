# ===== mode =====
# paper = simulated fills with live data (default). live = real money.
MODE=paper
# required to enable live mode, as a guard against accidents:
# LIVE_CONFIRM=yes-i-understand

# Use a paid RPC (Helius, Triton, QuickNode). The public one rate-limits hard.
RPC_URL=https://api.mainnet-beta.solana.com
# LIVE ONLY. Base58 secret key of a DEDICATED hot wallet. Never your main wallet.
WALLET_PRIVATE_KEY=
# optional, only needed for PumpPortal premium data streams
PUMPPORTAL_API_KEY=

# ===== sizing & risk =====
BUY_AMOUNT_SOL=0.05
MAX_OPEN_POSITIONS=3
DAILY_LOSS_LIMIT_SOL=0.5
SLIPPAGE_PCT=15
PRIORITY_FEE_SOL=0.0005
PAPER_START_SOL=5
# slippage assumed on paper fills (be pessimistic)
PAPER_SLIPPAGE_PCT=4

# ===== exits =====
TAKE_PROFIT_PCT=100
TAKE_PROFIT_SELL_PCT=50
STOP_LOSS_PCT=30
TRAILING_STOP_PCT=25
MAX_HOLD_MINUTES=30

# ===== signal =====
MIN_SCORE=60
# watch a new pump.fun launch this long before deciding
WATCH_SECONDS=45
MAX_DEV_BUY_PCT=8
MAX_TOP10_PCT=30
MAX_SINGLE_HOLDER_PCT=8
MIN_UNIQUE_BUYERS=8
# DexScreener/GMGN path (already-trading tokens)
MIN_LIQUIDITY_USD=15000
MAX_PAIR_AGE_HOURS=12
# narratives you believe in, always count as at least medium-hot (comma list)
NARRATIVES=

# ===== sources =====
ENABLE_PUMPPORTAL=true
ENABLE_DEXSCREENER=true
ENABLE_GMGN=true
ENABLE_RUGCHECK=true

# ===== telegram alerts + remote control (optional) =====
# token from @BotFather. Your numeric id from @userinfobot (message your bot once first).
TELEGRAM_BOT_TOKEN=9162898095:AAGw0RujFBxmfo4BK3NWT26GICcqa3BMb4A
TELEGRAM_CHAT_ID=6247930441
# only for group chats: comma list of user ids allowed to send commands
TELEGRAM_ALLOWED_USER_IDS=
